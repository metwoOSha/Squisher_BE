# Postgres connection string.
DATABASE_URL=

# Secret used to sign the auth JWT.
JWT_SECRET=

# Lifetime of that JWT, e.g. 7d.
EXPIRES_IN=

# Comma-separated origins allowed to call the API from a browser with cookies.
# Required in production, where the frontend sits on its own domain; leave empty
# in dev, since the Vite proxy makes those requests same-origin.
# e.g. CORS_ORIGINS=https://squisher-fe.vercel.app,https://squish.li
CORS_ORIGINS=
